# qwen27b (default) or codex
TEXT2SQL_BACKEND=qwen27b
LLAMA_CPP_MODEL=openai/swift15-27b-iq3-xxs
# Original Qwen3.8-27B (before 2026-11-07): openai/qwen3.8-27b-iq3-xxs
LLAMA_CPP_API_BASE=http://127.0.0.1:18080/v1
LLAMA_CPP_API_KEY=aaa
SQL_ATTEMPTS=3
REPORT_ATTEMPTS=2
MAX_LLM_CALLS=8
AGENT_TIMEOUT_SECONDS=300
QUERY_TIMEOUT_SECONDS=5
MAX_QUERY_ROWS=200
MAX_RESULT_BYTES=20000
# Codex backend only:
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=medium
MAX_QUERY_CALLS=8
