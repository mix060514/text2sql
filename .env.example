# Only qwen27b is supported.
TEXT2SQL_BACKEND=qwen27b
LLAMA_CPP_MODEL=openai/swift15-27b-iq3-xxs
# Original Qwen3.8-27B (before 2026-11-07): openai/qwen3.8-27b-iq3-xxs
LLAMA_CPP_API_BASE=http://127.0.0.1:18080/v1
LLAMA_CPP_API_KEY=aaa
SQL_ATTEMPTS=3
REPORT_ATTEMPTS=2
# Report writer thinking (off by default: it caused 120 s request timeouts)
REPORT_THINKING=false
# Thinking token caps for SQL planner / reviewer (-1 = unlimited)
SQL_THINKING_BUDGET=4096
REVIEW_THINKING_BUDGET=1024
MAX_LLM_CALLS=8
AGENT_TIMEOUT_SECONDS=600
QUERY_TIMEOUT_SECONDS=5
MAX_QUERY_ROWS=200
MAX_RESULT_BYTES=20000
