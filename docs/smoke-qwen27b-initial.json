      "passed": true,
      "data_correct": true,
      "chart_correct": true,
      "seconds": 173.13,
      "sql": "WITH quarters AS (\n  SELECT 1 AS quarter\n  UNION ALL SELECT 2\n  UNION ALL SELECT 3\n  UNION ALL SELECT 4\n),\nrevenue AS (\n  SELECT ((CAST(strftime('%m', \"Order Date\") AS INTEGER) - 1) / 3 + 1) AS quarter,\n         SUM(\"Total Revenue\") AS total_revenue\n  FROM sales_data\n  WHERE \"Order Date\" >= '2023-01-01' AND \"Order Date\" < '2024-01-01'\n  GROUP BY 1\n)\nSELECT 'Q' || quarters.quarter AS \"Quarter\",\n       COALESCE(revenue.total_revenue, 0) AS \"Total Revenue\"\nFROM quarters\nLEFT JOIN revenue ON quarters.quarter = revenue.quarter\nORDER BY quarters.quarter;",
