      "sql": "WITH quarters AS (\n  SELECT 1 AS q\n  UNION ALL SELECT 2\n  UNION ALL SELECT 3\n  UNION ALL SELECT 4\n),\nq AS (\n  SELECT 'Q' || q AS \"Quarter\", q AS \"QuarterNum\"\n  FROM quarters\n),\nsales AS (\n  SELECT ((CAST(strftime('%m', \"Order Date\") AS INTEGER) - 1) / 3 + 1) AS \"QuarterNum\",\n         SUM(\"Total Revenue\") AS \"Total Revenue\"\n  FROM sales_data\n  WHERE strftime('%Y', \"Order Date\") = '2023'\n  GROUP BY \"QuarterNum\"\n)\nSELECT q.\"Quarter\" AS \"Quarter\", COALESCE(s.\"Total Revenue\", 0) AS \"Total Revenue\"\nFROM q\nLEFT JOIN sales s ON q.\"QuarterNum\" = s.\"QuarterNum\"\nORDER BY q.\"QuarterNum\";",
