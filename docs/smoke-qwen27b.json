      "seconds": 65.21,
      "sql": "WITH total AS (SELECT SUM(\"Total Revenue\") AS total_revenue FROM sales_data) SELECT s.\"Region\", SUM(s.\"Total Revenue\") AS \"Total Revenue\", ROUND(SUM(s.\"Total Revenue\") * 100.0 / NULLIF(t.total_revenue, 0), 2) AS \"Sales Share %\" FROM sales_data s CROSS JOIN total t GROUP BY s.\"Region\" ORDER BY \"Total Revenue\" DESC;",
